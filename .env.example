# Supabase 프로젝트 설정 (Settings > API, Settings > Data API > JWT Settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Claude API (Anthropic Console)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 네이버 검색 API (src/collectors의 source_type='news' 수집기에서만 사용)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# 배치 workspace (미확정: 지침 §9-B-3 — 실제 UUID 공유 필요)
MYWIKI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
